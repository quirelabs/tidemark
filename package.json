{
  "name": "tidemark-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Tidemark, an open-source CLI that captures database mutations on a branch or CI Postgres and renders them as a reviewable semantic state diff.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:watch": "pnpm --filter @quirelabs/tidemark-core test:watch",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter tidemark-demo-app e2e",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
